APP_ORIGIN=http://localhost:8080
TAB_SESSION_TEST_MODE=false
API_PORT=3001
# Firebase project settings > Project ID.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_PORT=3002
FIREBASE_MARKETPLACE_PORT=3003
# Private service-account JSON file path. Do not share or commit the key file.
GOOGLE_APPLICATION_CREDENTIALS=
# SQLite remains active until Firebase is verified and application queries are migrated.
DATABASE_PATH=data/marketplace.sqlite
UPLOADS_PATH=data/uploads
# Use only during npm run admin:create; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Administrator
# Backend only. Never prefix secret keys with VITE_.
PAYSTACK_SECRET_KEY=
